+u32 CanMonLearnTMHM(struct Pokemon *mon, u16 tm)
+{
+    u16 species = GetMonData(mon, MON_DATA_SPECIES2, 0);
+    u32 mask;
+
+    if (species == SPECIES_EGG || tm >= NUM_TMHM_MOVES)
+        return 0;
+
+    mask = 1u << (tm & 31);
+    return gTMHMLearnsets[species][tm >> 5] & mask;
