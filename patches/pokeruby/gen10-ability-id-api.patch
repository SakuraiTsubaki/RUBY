+    if (boxMon == NULL)
+        return ABILITY_NONE;
+
+    species = GetBoxMonData(boxMon, MON_DATA_SPECIES);
+    if (species == SPECIES_NONE || species >= NUM_SPECIES)
+        return ABILITY_NONE;
+
+    if (extended != NULL && extended->abilityId != ABILITY_NONE)
+        return extended->abilityId;
+
+    altAbility = GetBoxMonData(boxMon, MON_DATA_ALT_ABILITY);
+    if (altAbility && gBaseStats[species].ability2 != ABILITY_NONE)
+        return gBaseStats[species].ability2;
+    return gBaseStats[species].ability1;
+}
+
+RubyAbilityId RubySaveExtensionGetPartyAbility(u8 slot)
+{
+    if (slot >= PARTY_SIZE)
+        return ABILITY_NONE;
+    return RubySaveExtensionResolveBoxMonAbility(&gPlayerParty[slot].box, RubySaveExtensionGetPartyMon(slot));
+}
