+void RubySaveExtensionMoveMonData(struct RubyExtendedMonData *dest, struct RubyExtendedMonData *src)
+{
+    if (dest == src)
+        return;
+    RubySaveExtensionCopyMonData(dest, src);
+    RubySaveExtensionClearMonData(src);
+}
+
+static void MigrateLegacyBoxMonAbility(struct BoxPokemon *boxMon, struct RubyExtendedMonData *extended)
+{
+    u16 species;
+    u8 altAbility;
+
+    if (extended == NULL || extended->abilityId != ABILITY_NONE)
+        return;
+
+    species = GetBoxMonData(boxMon, MON_DATA_SPECIES);
+    if (species == SPECIES_NONE || species >= NUM_SPECIES)
+        return;
+
+    altAbility = GetBoxMonData(boxMon, MON_DATA_ALT_ABILITY);
+    if (altAbility && gBaseStats[species].ability2 != ABILITY_NONE)
+    {
+        extended->abilityId = gBaseStats[species].ability2;
+        extended->abilitySlot = 1;
+    }
+    else
+    {
+        extended->abilityId = gBaseStats[species].ability1;
+        extended->abilitySlot = 0;
+    }
+}
+
+void RubySaveExtensionMigrateLegacyMons(void)
+{
+    u8 partySlot;
+    u8 daycareSlot;
+    u8 box;
+    u8 slot;
+
+    for (partySlot = 0; partySlot < PARTY_SIZE; partySlot++)
+        MigrateLegacyBoxMonAbility(&gPlayerParty[partySlot].box, RubySaveExtensionGetPartyMon(partySlot));
+
+    for (daycareSlot = 0; daycareSlot < RUBY_EXT_DAYCARE_COUNT; daycareSlot++)
+        MigrateLegacyBoxMonAbility(&gSaveBlock1.daycare.mons[daycareSlot], RubySaveExtensionGetDaycareMon(daycareSlot));
+
+    for (box = 0; box < 14; box++)
+    {
+        for (slot = 0; slot < 30; slot++)
+            MigrateLegacyBoxMonAbility(&gPokemonStorage.boxes[box][slot], RubySaveExtensionGetPcMon(box, slot));
+    }
+}
