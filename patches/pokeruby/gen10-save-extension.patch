diff --git a/include/ruby_save_extension.h b/include/ruby_save_extension.h
new file mode 100644
--- /dev/null
+++ b/include/ruby_save_extension.h
@@ -0,0 +1,56 @@
+#ifndef GUARD_RUBY_SAVE_EXTENSION_H
+#define GUARD_RUBY_SAVE_EXTENSION_H
+
+#include "global.h"
+
+#define RUBY_SAVE_EXTENSION_MAGIC 0x58594252 // "RBYX" in little endian
+#define RUBY_SAVE_EXTENSION_VERSION 1
+#define RUBY_SAVE_EXTENSION_SIZE 0x1800
+#define RUBY_SAVE_EXTENSION_HEADER_SIZE 12
+#define RUBY_SAVE_EXTENSION_PAYLOAD_SIZE (RUBY_SAVE_EXTENSION_SIZE - RUBY_SAVE_EXTENSION_HEADER_SIZE)
+
+#define RUBY_EXT_PARTY_COUNT 6
+#define RUBY_EXT_DAYCARE_COUNT 2
+#define RUBY_EXT_PC_COUNT (14 * 30)
+#define RUBY_EXT_MON_COUNT (RUBY_EXT_PARTY_COUNT + RUBY_EXT_DAYCARE_COUNT + RUBY_EXT_PC_COUNT)
+
+#define RUBY_EXT_PARTY_BASE 0
+#define RUBY_EXT_DAYCARE_BASE (RUBY_EXT_PARTY_BASE + RUBY_EXT_PARTY_COUNT)
+#define RUBY_EXT_PC_BASE (RUBY_EXT_DAYCARE_BASE + RUBY_EXT_DAYCARE_COUNT)
+
+// Persistent modern metadata that cannot be represented by the classic
+// 0x50-byte Generation III BoxPokemon record. Form storage is reserved here,
+// but form-change behavior remains intentionally deferred.
+struct RubyExtendedMonData
+{
+    u16 abilityId;
+    u16 formId;
+    u8 teraType;
+    u8 abilitySlot;
+    u16 flags;
+    u32 reserved;
+}; // size = 12
+
+#define RUBY_SAVE_EXTENSION_GLOBAL_SIZE 996
+
+struct RubySaveExtension
+{
+    u32 magic;
+    u16 version;
+    u16 payloadSize;
+    u16 crc16;
+    u16 flags;
+    struct RubyExtendedMonData mons[RUBY_EXT_MON_COUNT];
+    u8 global[RUBY_SAVE_EXTENSION_GLOBAL_SIZE];
+}; // size = 0x1800
+
+extern struct RubySaveExtension gRubySaveExtension;
+
+void RubySaveExtensionInit(void);
+void RubySaveExtensionPrepareWrite(void);
+void RubySaveExtensionBeginLoad(void);
+void RubySaveExtensionReadSector(u16 sectionId, const u8 *sectorData, u16 chunkSize);
+void RubySaveExtensionEndLoad(void);
+void RubySaveExtensionWriteSector(u16 sectionId, u8 *sectorData, u16 chunkSize);
+
+#endif // GUARD_RUBY_SAVE_EXTENSION_H
diff --git a/src/ruby_save_extension.c b/src/ruby_save_extension.c
new file mode 100644
--- /dev/null
+++ b/src/ruby_save_extension.c
@@ -0,0 +1,125 @@
+#include "global.h"
+#include "ruby_save_extension.h"
+#include "util.h"
+
+#define SAVE_SECTION_DATA_END 0xFF4
+#define SAVE_SECTION_COUNT 14
+
+// The classic Ruby save writer copies only the declared chunk bytes into each
+// 4 KiB sector, zeroes the remainder through 0xFF3, and stores the vanilla
+// footer at 0xFF4.  The offsets below concatenate those zero-filled gaps into
+// one logical sidecar stream without changing the vanilla checksum region.
+static const u16 sExtensionOffsets[SAVE_SECTION_COUNT] =
+{
+    0,
+    1892,
+    2008,
+    2124,
+    2240,
+    3188,
+    3304,
+    3420,
+    3536,
+    3652,
+    3768,
+    3884,
+    4000,
+    4116,
+};
+
+EWRAM_DATA struct RubySaveExtension gRubySaveExtension = {0};
+
+static void ClearExtension(void)
+{
+    u32 i;
+    u8 *data = (u8 *)&gRubySaveExtension;
+
+    for (i = 0; i < sizeof(gRubySaveExtension); i++)
+        data[i] = 0;
+}
+
+static bool8 HasValidHeader(void)
+{
+    if (gRubySaveExtension.magic != RUBY_SAVE_EXTENSION_MAGIC)
+        return FALSE;
+    if (gRubySaveExtension.version != RUBY_SAVE_EXTENSION_VERSION)
+        return FALSE;
+    if (gRubySaveExtension.payloadSize != RUBY_SAVE_EXTENSION_PAYLOAD_SIZE)
+        return FALSE;
+    return TRUE;
+}
+
+static u16 CalculateExtensionCrc(void)
+{
+    const u8 *data = (const u8 *)&gRubySaveExtension;
+    return CalcCRC16(data + RUBY_SAVE_EXTENSION_HEADER_SIZE, RUBY_SAVE_EXTENSION_PAYLOAD_SIZE);
+}
+
+void RubySaveExtensionInit(void)
+{
+    ClearExtension();
+    gRubySaveExtension.magic = RUBY_SAVE_EXTENSION_MAGIC;
+    gRubySaveExtension.version = RUBY_SAVE_EXTENSION_VERSION;
+    gRubySaveExtension.payloadSize = RUBY_SAVE_EXTENSION_PAYLOAD_SIZE;
+    gRubySaveExtension.crc16 = CalculateExtensionCrc();
+}
+
+void RubySaveExtensionPrepareWrite(void)
+{
+    if (!HasValidHeader())
+        RubySaveExtensionInit();
+    gRubySaveExtension.crc16 = CalculateExtensionCrc();
+}
+
+void RubySaveExtensionBeginLoad(void)
+{
+    ClearExtension();
+}
+
+void RubySaveExtensionReadSector(u16 sectionId, const u8 *sectorData, u16 chunkSize)
+{
+    u16 i;
+    u16 offset;
+    u16 available;
+    u16 copySize;
+    u8 *extensionData = (u8 *)&gRubySaveExtension;
+
+    if (sectionId >= SAVE_SECTION_COUNT || chunkSize > SAVE_SECTION_DATA_END)
+        return;
+
+    offset = sExtensionOffsets[sectionId];
+    available = SAVE_SECTION_DATA_END - chunkSize;
+    if (offset >= RUBY_SAVE_EXTENSION_SIZE)
+        return;
+    copySize = min(available, RUBY_SAVE_EXTENSION_SIZE - offset);
+
+    for (i = 0; i < copySize; i++)
+        extensionData[offset + i] = sectorData[chunkSize + i];
+}
+
+void RubySaveExtensionEndLoad(void)
+{
+    if (!HasValidHeader() || gRubySaveExtension.crc16 != CalculateExtensionCrc())
+        RubySaveExtensionInit();
+}
+
+void RubySaveExtensionWriteSector(u16 sectionId, u8 *sectorData, u16 chunkSize)
+{
+    u16 i;
+    u16 offset;
+    u16 available;
+    u16 copySize;
+    const u8 *extensionData = (const u8 *)&gRubySaveExtension;
+
+    if (sectionId >= SAVE_SECTION_COUNT || chunkSize > SAVE_SECTION_DATA_END)
+        return;
+
+    offset = sExtensionOffsets[sectionId];
+    available = SAVE_SECTION_DATA_END - chunkSize;
+    if (offset >= RUBY_SAVE_EXTENSION_SIZE)
+        return;
+    copySize = min(available, RUBY_SAVE_EXTENSION_SIZE - offset);
+
+    for (i = 0; i < copySize; i++)
+        sectorData[chunkSize + i] = extensionData[offset + i];
+}
