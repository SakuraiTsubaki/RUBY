diff --git a/src/event_data.c b/src/event_data.c
--- a/src/event_data.c
+++ b/src/event_data.c
@@
 void DisableMysteryEvent(void)
 {
-    FlagClear(FLAG_SYS_EXDATA_ENABLE);
+    // Always-on external events: this state may no longer be disabled.
+    FlagSet(FLAG_SYS_EXDATA_ENABLE);
 }
@@
 bool32 IsMysteryEventEnabled(void)
 {
-    return FlagGet(FLAG_SYS_EXDATA_ENABLE);
+    // A valid save always exposes Mystery Event. Keep the saved flag for
+    // compatibility with old saves/tools, but do not use it as a gate.
+    return TRUE;
 }

diff --git a/src/mystery_event_script.c b/src/mystery_event_script.c
--- a/src/mystery_event_script.c
+++ b/src/mystery_event_script.c
@@
 u16 GetRecordMixingGift(void)
 {
     struct RecordMixingGiftData *data = &gSaveBlock1.recordMixingGift.data;
@@
     else
     {
         u16 itemId = data->itemId;
-        data->quantity--;
-        if (data->quantity == 0)
-            ClearRecordMixingGift();
-        else
-            gSaveBlock1.recordMixingGift.checksum = CalcRecordMixingGiftChecksum();
-
+        // External-event permanence: installed distribution stock never
+        // depletes. The payload/checksum remain unchanged.
         return itemId;
     }
 }

