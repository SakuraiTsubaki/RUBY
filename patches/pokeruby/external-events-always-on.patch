diff --git a/data/maps/LittlerootTown/scripts.inc b/data/maps/LittlerootTown/scripts.inc
--- a/data/maps/LittlerootTown/scripts.inc
+++ b/data/maps/LittlerootTown/scripts.inc
@@
 LittlerootTown_EventScript_Boy:: @ 814D6D6
 	msgbox LittlerootTown_Text_BirchSpendsDaysInLab, MSGBOX_NPC
 	end
+
+LittlerootTown_EventScript_EventTicketCourier::
+	lock
+	faceplayer
+	msgbox LittlerootTown_Text_EventTicketCourierChoose, MSGBOX_DEFAULT
+	multichoice 12, 0, 73, 0
+	switch VAR_RESULT
+	case 0, LittlerootTown_EventScript_EventTicketCourierEon
+	case 1, LittlerootTown_EventScript_EventTicketCourierAurora
+	case 2, LittlerootTown_EventScript_EventTicketCourierMystic
+	case 3, LittlerootTown_EventScript_EventTicketCourierOldSeaMap
+	case MULTI_B_PRESSED, LittlerootTown_EventScript_EventTicketCourierCancel
+	goto LittlerootTown_EventScript_EventTicketCourierCancel
+
+LittlerootTown_EventScript_EventTicketCourierEon::
+	checkitem ITEM_EON_TICKET, 1
+	compare VAR_RESULT, 1
+	goto_if_eq LittlerootTown_EventScript_EventTicketCourierEonAlreadyOwned
+	checkpcitem ITEM_EON_TICKET, 1
+	compare VAR_RESULT, 1
+	goto_if_eq LittlerootTown_EventScript_EventTicketCourierEonAlreadyOwned
+	giveitem ITEM_EON_TICKET
+	compare VAR_RESULT, 0
+	goto_if_eq Common_EventScript_ShowBagIsFull
+	setflag FLAG_SYS_HAS_EON_TICKET
+	goto LittlerootTown_EventScript_EventTicketCourierDone
+
+LittlerootTown_EventScript_EventTicketCourierEonAlreadyOwned::
+	@ Repair migrated saves that contain the ticket but lack the original flag.
+	setflag FLAG_SYS_HAS_EON_TICKET
+	goto LittlerootTown_EventScript_EventTicketCourierAlreadyOwned
+
+LittlerootTown_EventScript_EventTicketCourierAurora::
+	checkitem ITEM_AURORA_TICKET, 1
+	compare VAR_RESULT, 1
+	goto_if_eq LittlerootTown_EventScript_EventTicketCourierAlreadyOwned
+	checkpcitem ITEM_AURORA_TICKET, 1
+	compare VAR_RESULT, 1
+	goto_if_eq LittlerootTown_EventScript_EventTicketCourierAlreadyOwned
+	giveitem ITEM_AURORA_TICKET
+	compare VAR_RESULT, 0
+	goto_if_eq Common_EventScript_ShowBagIsFull
+	goto LittlerootTown_EventScript_EventTicketCourierDone
+
+LittlerootTown_EventScript_EventTicketCourierMystic::
+	checkitem ITEM_MYSTIC_TICKET, 1
+	compare VAR_RESULT, 1
+	goto_if_eq LittlerootTown_EventScript_EventTicketCourierAlreadyOwned
+	checkpcitem ITEM_MYSTIC_TICKET, 1
+	compare VAR_RESULT, 1
+	goto_if_eq LittlerootTown_EventScript_EventTicketCourierAlreadyOwned
+	giveitem ITEM_MYSTIC_TICKET
+	compare VAR_RESULT, 0
+	goto_if_eq Common_EventScript_ShowBagIsFull
+	goto LittlerootTown_EventScript_EventTicketCourierDone
+
+LittlerootTown_EventScript_EventTicketCourierOldSeaMap::
+	checkitem ITEM_OLD_SEA_MAP, 1
+	compare VAR_RESULT, 1
+	goto_if_eq LittlerootTown_EventScript_EventTicketCourierAlreadyOwned
+	checkpcitem ITEM_OLD_SEA_MAP, 1
+	compare VAR_RESULT, 1
+	goto_if_eq LittlerootTown_EventScript_EventTicketCourierAlreadyOwned
+	giveitem ITEM_OLD_SEA_MAP
+	compare VAR_RESULT, 0
+	goto_if_eq Common_EventScript_ShowBagIsFull
+	goto LittlerootTown_EventScript_EventTicketCourierDone
+
+LittlerootTown_EventScript_EventTicketCourierAlreadyOwned::
+	msgbox LittlerootTown_Text_EventTicketCourierAlreadyOwned, MSGBOX_DEFAULT
+	release
+	end
+
+LittlerootTown_EventScript_EventTicketCourierDone::
+	msgbox LittlerootTown_Text_EventTicketCourierDone, MSGBOX_DEFAULT
+	release
+	end
+
+LittlerootTown_EventScript_EventTicketCourierCancel::
+	msgbox LittlerootTown_Text_EventTicketCourierCancel, MSGBOX_DEFAULT
+	release
+	end
 
 LittlerootTown_EventScript_Twin:: @ 814D6DF
