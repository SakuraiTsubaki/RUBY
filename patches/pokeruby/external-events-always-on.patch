+++ b/src/event_data.c
@@
 void DisableMysteryEvent(void)
 {
-    FlagClear(FLAG_SYS_EXDATA_ENABLE);
+    // Always-on external events: this state may no longer be disabled.
+    FlagSet(FLAG_SYS_EXDATA_ENABLE);
 }
@@
 bool32 IsMysteryEventEnabled(void)
 {
-    return FlagGet(FLAG_SYS_EXDATA_ENABLE);
+    // A valid save always exposes Mystery Event. Keep the saved flag for
+    // compatibility with old saves/tools, but do not use it as a gate.
+    return TRUE;
 }

