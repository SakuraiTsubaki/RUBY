-}
+    for (i = 0; i < copySize; i++)
+        sectorData[chunkSize + i] = extensionData[offset + i];
+}
+
+struct RubyExtendedMonData *RubySaveExtensionGetPartyMon(u8 slot)
+{
+    if (slot >= RUBY_EXT_PARTY_COUNT)
+        return NULL;
+    return &gRubySaveExtension.mons[RUBY_EXT_PARTY_BASE + slot];
+}
+
+struct RubyExtendedMonData *RubySaveExtensionGetDaycareMon(u8 slot)
+{
+    if (slot >= RUBY_EXT_DAYCARE_COUNT)
+        return NULL;
+    return &gRubySaveExtension.mons[RUBY_EXT_DAYCARE_BASE + slot];
+}
+
+struct RubyExtendedMonData *RubySaveExtensionGetPcMon(u8 box, u8 slot)
+{
+    if (box >= 14 || slot >= 30)
+        return NULL;
+    return &gRubySaveExtension.mons[RUBY_EXT_PC_BASE + box * 30 + slot];
+}
+
+void RubySaveExtensionClearMonData(struct RubyExtendedMonData *data)
+{
+    u32 i;
+    u8 *bytes;
+
+    if (data == NULL)
+        return;
+
+    bytes = (u8 *)data;
+    for (i = 0; i < sizeof(*data); i++)
+        bytes[i] = 0;
+}
+
+void RubySaveExtensionCopyMonData(struct RubyExtendedMonData *dest, const struct RubyExtendedMonData *src)
+{
+    if (dest == NULL)
+        return;
+    if (src == NULL)
+    {
+        RubySaveExtensionClearMonData(dest);
+        return;
+    }
+    *dest = *src;
+}
+
+void RubySaveExtensionMoveMonData(struct RubyExtendedMonData *dest, struct RubyExtendedMonData *src)
+{
+    if (dest == src)
+        return;
+    RubySaveExtensionCopyMonData(dest, src);
+    RubySaveExtensionClearMonData(src);
+}
